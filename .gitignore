# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Captured sweeps. Regenerated by the capture button in one press, hundreds
# of files per run, and meaningless outside the run that produced them.
frames/
*.zip

# Render output and scratch figures.
out/

# Source captures. Gigabyte-scale PLY files that belong wherever you keep
# your captures, not in git.
*.ply
data/
scenes/

# Exported tilesets.
#
# bigsur is deliberately committed: the page loads it on startup, so without
# it a fresh clone opens to an empty viewer, and a demo that needs a
# 10-minute export before it shows anything is not a demo. At 22 MB it is
# under GitHub's warning threshold.
#
# The others are not. They exist to compare against and can be rebuilt with
#     python scripts/export_wang.py --preset bicycle
web/data/*.splat
!web/data/bigsur.splat

# The .json beside each tileset stays in either case - a few kilobytes, and
# it is the only written record of the format the browser reads.

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db