# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Captured sweeps. Regenerated by the capture button in one press, hundreds
# of files per run, and meaningless outside the run that produced them.
frames/
*.zip

# Render output and scratch figures.
out/

# Source captures. Gigabyte-scale PLY files that belong wherever you keep
# your captures, not in git.
*.ply
/data/
scenes/
downloads/

# Exported tilesets and height fields.
#
# Only the desert tileset is public: its splats, manifest, height field,
# sediment and far-field atlas. Without it a fresh clone or the live page
# would open on the starter scene alone, and a demo that needs a 10-minute
# export before it shows anything is not a demo. The starter needs no file;
# terrains are generated in the browser.
#
# Every other tileset, height field and the folder's index.json stay in the
# working copy that made them (rebuilt with
#     python scripts/export_wang.py data/raw/<name>.ply --preset <name>
# ); the viewer looks for the desert whether or not an index is there.
#
# The root data/ rule above is anchored with a leading slash on purpose: an
# unanchored 'data/' also matches web/data/, and git cannot re-include files
# inside an excluded folder, so exceptions here silently did nothing.

web/data/*
!web/data/desert.*

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db